#!/usr/bin/env python3
"""Fake `lizard` for crap-gate tests: logs argv, prints the fixture CSV verbatim."""
import os
import sys

here = os.path.dirname(os.path.abspath(__file__))
log = os.environ.get("FAKE_LIZARD_LOG")
if log:
    with open(log, "a") as f:
        f.write(" ".join(sys.argv[1:]) + "\n")
if sys.argv[1:2] != ["--csv"]:
    sys.exit(f"fake lizard: unexpected args {sys.argv[1:]!r}")
with open(os.path.join(here, "..", "lizard.csv")) as f:
    sys.stdout.write(f.read())
