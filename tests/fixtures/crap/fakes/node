#!/usr/bin/env python3
"""Fake `node` for crap-gate tests: logs argv; prints ts-complexity JSON, or fails when FAKE_NODE_FAIL is set."""
import json
import os
import sys

log = os.environ.get("FAKE_NODE_LOG")
if log:
    with open(log, "a") as f:
        f.write(" ".join(sys.argv[1:]) + "\n")
if os.environ.get("FAKE_NODE_FAIL"):
    sys.exit("typescript not found")
if not sys.argv[1:2] or not sys.argv[1].endswith("ts_complexity.cjs"):
    sys.exit(f"fake node: unexpected args {sys.argv[1:]!r}")
sys.stdout.write(json.dumps({p: [["pick", 1, 3, 2], ["Panel", 5, 8, 2], ["label", 6, 6, 2]] for p in sys.argv[2:]}))
